<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Poppins:wght@700&family=Barlow+Condensed:wght@600;700&display=swap" rel="stylesheet">
<style>
/* Punto Ciego listicle — recreation of veloma.store/pages/listicle_1 structure
   Original code. Color roles mapped from reference to Punto Ciego brand palette
   (documented exception in audit style-token-map). */

:root {
  --black: #000000;
  --ink: #26211b;            /* warm reading ink (~15:1 on white) */
  --brand: #c1531a;            /* CTA / accent (ref role: #315d3e) */
  --brand-dark: #9c3f0f;       /* hover */
  --amber: #e08a3c;            /* ticker strip (ref role: #7daf8c) */
  --amber-soft: #f2c18f;       /* marker highlight (ref role: sage highlight) */
  --cream: #f5ecdd;            /* alternating band (ref role: #e9f9ed) */
  --cream-deep: #efe3cc;
  --charcoal: #211c16;         /* footer (ref role: #1b4227) */
  --white: #ffffff;
  --font-body: "Inter", "Inter Display", -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  --font-promo: "Poppins", var(--font-body);
  --font-brand: "Barlow Condensed", "Arial Narrow", var(--font-body);
  --col-text: 680px;
  --col-img: 605px;
  --radius-btn: 8px;
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--font-body);
  font-size: 16px;
  color: var(--ink);
  background: var(--white);
  -webkit-font-smoothing: antialiased;
}
img { display: block; max-width: 100%; }

/* ---------- announcement bar ---------- */
.promo {
  background: var(--black);
  color: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24px;
  min-height: 64px;
  padding: 10px 16px;
  flex-wrap: wrap;
  text-align: center;
}
.promo strong { font-family: var(--font-promo); font-weight: 700; font-size: 20px; }
.promo .btn { border-radius: 0; min-width: 190px; }

/* ---------- buttons ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--brand);
  color: var(--white);
  font-weight: 700;
  font-size: 14px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  text-decoration: none;
  padding: 12px 24px;
  min-height: 44px;
  border: 0;
  border-radius: var(--radius-btn);
  cursor: pointer;
  transition: background 0.15s ease;
}
.btn:hover { background: var(--brand-dark); }
.btn:focus-visible { outline: 3px solid var(--amber); outline-offset: 2px; }

/* ---------- layout containers ---------- */
.wrap { max-width: 1360px; margin: 0 auto; padding: 0 40px; }

/* ---------- hero ---------- */
.hero { background: var(--white); }
.hero .wrap {
  display: grid;
  grid-template-columns: minmax(0, 651px) minmax(0, 433px);
  justify-content: space-between;
  align-items: center;
  gap: 40px;
  padding-top: 28px;
  padding-bottom: 28px;
}
.hero h1 {
  font-size: clamp(26px, 2.4vw + 12px, 35px);
  line-height: 1.16;
  text-wrap: balance;
  font-weight: 800;
  color: var(--black);
}
.hero h1 .hl {
  background: linear-gradient(transparent 58%, var(--amber-soft) 58%);
}
.hero-media { width: 100%; aspect-ratio: 433 / 328; }
.hero-media img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; }

/* ---------- trust ticker ---------- */
.ticker {
  background: var(--amber);
  color: var(--charcoal);
  overflow: hidden;
  padding: 10px 0;
}
.ticker-track {
  display: flex;
  gap: 48px;
  width: max-content;
  animation: ticker 22s linear infinite;
}
.ticker span {
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  white-space: nowrap;
}
@keyframes ticker { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@media (prefers-reduced-motion: reduce) {
  .ticker-track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; }
}

/* ---------- intro band ---------- */
.intro { background: var(--cream); }
.intro .wrap {
  display: grid;
  grid-template-columns: minmax(0, var(--col-img)) minmax(0, var(--col-text));
  justify-content: space-between;
  align-items: center;
  gap: 60px;
  padding-top: 44px;
  padding-bottom: 44px;
}
.intro-media { width: 100%; aspect-ratio: 605 / 371; }
.intro-media img { width: 100%; height: 100%; object-fit: cover; }
.intro p { font-size: 18px; line-height: 1.55; margin-bottom: 22px; max-width: 62ch; text-wrap: pretty; }
.intro p:last-child { margin-bottom: 0; }

/* ---------- reason rows ---------- */
.reason { padding: 48px 0; }
.reason.flip { background: var(--cream); }
.reason .wrap {
  display: grid;
  grid-template-columns: minmax(0, var(--col-text)) minmax(0, var(--col-img));
  grid-template-rows: 1fr auto auto 1fr;
  grid-template-areas:
    ".    media"
    "head media"
    "body media"
    ".    media";
  column-gap: 60px;
  justify-content: space-between;
}
.reason.flip .wrap {
  grid-template-columns: minmax(0, var(--col-img)) minmax(0, var(--col-text));
  grid-template-areas:
    "media ."
    "media head"
    "media body"
    "media .";
}
.reason-head { grid-area: head; }
.reason-body { grid-area: body; }
.reason-media { grid-area: media; align-self: center; }
/* reference renders reasons 3/7/9 with a narrower 540px media box, right-aligned */
.reason-media.cap-540 { max-width: 540px; justify-self: end; }
.reason.flip .reason-media.cap-540 { justify-self: start; }

.reason-label {
  display: inline-block;
  font-size: 40px;
  line-height: 1.15;
  font-weight: 800;
  color: var(--black);
  background: linear-gradient(transparent 55%, var(--amber-soft) 55%);
  margin-bottom: 16px;
}
.reason-head h2 {
  font-size: 27px;
  line-height: 1.25;
  font-weight: 700;
  color: var(--black);
  margin-bottom: 18px;
  text-wrap: balance;
}
.reason-body p { font-size: 18px; line-height: 1.55; margin-bottom: 22px; max-width: 62ch; text-wrap: pretty; }
.reason-body p:last-child { margin-bottom: 0; }
.reason-body .btn { margin-top: 22px; }

.reason-media { width: 100%; }
.reason-media img { width: 100%; height: 100%; object-fit: cover; }
.reason-media img.fit-contain,
.intro-media img.fit-contain { object-fit: contain; background: #23211c; }
/* per-slot measured aspect ratios (reference rendered boxes @1440) */
.ar-620x396 { aspect-ratio: 620 / 396; }
.ar-605x435 { aspect-ratio: 605 / 435; }
.ar-540x316 { aspect-ratio: 540 / 316; }
.ar-605x460 { aspect-ratio: 605 / 460; }
.ar-620x428 { aspect-ratio: 620 / 428; }
.ar-540x429 { aspect-ratio: 540 / 429; }

/* measured placeholder (slots with no owned asset) */
.ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 16px;
  background: repeating-linear-gradient(45deg, #eee6d6, #eee6d6 14px, #f7f1e6 14px, #f7f1e6 28px);
  border: 1px dashed #c9b989;
  color: #6b5d49;
  font-size: 13px;
  letter-spacing: 0.02em;
}

/* ---------- accessibility helpers ---------- */
.skip-link {
  position: absolute;
  left: -9999px;
  top: 0;
  background: var(--brand);
  color: var(--white);
  padding: 10px 16px;
  z-index: 10;
}
.skip-link:focus { left: 8px; top: 8px; }
.sr-only {
  position: absolute;
  width: 1px; height: 1px;
  padding: 0; margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap; border: 0;
}

/* ---------- guarantee seal (SVG fills the measured slot on the white row) ---------- */
.seal-wrap { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
.seal-wrap svg { height: 100%; width: auto; max-width: 100%; }

/* ---------- reviews ---------- */
.reviews { padding: 40px 0 56px; }
.reviews-rating {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 16px;
  line-height: 1.5;
  margin-bottom: 14px;
}
.reviews h2 { font-size: 34px; font-weight: 800; color: var(--black); margin-bottom: 28px; }
.review-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 32px;
  margin-bottom: 36px;
}
.review-card { display: flex; flex-direction: column; }
.review-card blockquote { font-size: 16px; line-height: 1.55; color: rgba(0, 0, 0, 0.78); margin-bottom: 16px; }
.review-who { display: flex; align-items: center; gap: 10px; margin-top: auto; }
.review-name { font-size: 16px; font-weight: 600; }
.reviews-intro { font-size: 17px; line-height: 1.55; max-width: 66ch; margin-bottom: 28px; text-wrap: pretty; }
.reviews-closing { font-size: 17px; line-height: 1.55; max-width: 66ch; margin-bottom: 22px; }
.review-title { font-size: 20px; line-height: 1.35; font-weight: 700; margin-bottom: 10px; text-wrap: balance; }
.review-meta { font-size: 13px; color: rgba(0, 0, 0, 0.62); }
.review-who > div { display: flex; flex-direction: column; gap: 2px; }
.review-avatar {
  width: 40px; height: 40px;
  border-radius: 50%;
  background: repeating-linear-gradient(45deg, #eee6d6, #eee6d6 6px, #f7f1e6 6px, #f7f1e6 12px);
  border: 1px dashed #c9b989;
  flex: 0 0 auto;
}
.review-card {
  border: 1px solid rgba(0, 0, 0, 0.1);
  border-radius: 8px;
  padding: 22px;
  background: var(--white);
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
}
.footer-tagline { margin-top: 14px; font-size: 15px; opacity: 0.85; }


/* ---------- footer ---------- */
.footer { background: var(--charcoal); color: var(--white); padding: 56px 0 32px; }
.footer a { color: var(--white); text-decoration: none; }
.footer a:hover { text-decoration: underline; }
.footer-top {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 529px);
  gap: 48px;
  align-items: start;
  padding-bottom: 40px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
}
.footer-brand { font-family: var(--font-brand); font-weight: 700; font-size: 56px; line-height: 0.95; letter-spacing: 0.02em; text-transform: uppercase; }
.footer-brand small { display: block; font-family: var(--font-body); font-weight: 400; font-size: 13px; letter-spacing: 0.24em; margin-top: 6px; }
.newsletter h3 { font-size: 22px; margin-bottom: 8px; }
.newsletter p { font-size: 15px; line-height: 1.5; opacity: 0.85; margin-bottom: 16px; }
.newsletter form { display: flex; gap: 10px; flex-wrap: wrap; }
.newsletter input {
  flex: 1 1 220px;
  min-height: 48px;
  padding: 10px 14px;
  font-size: 15px;
  border: 1px solid rgba(255, 255, 255, 0.4);
  background: rgba(255, 255, 255, 0.06);
  color: var(--white);
  border-radius: 5px;
}
.newsletter input:focus-visible { outline: 3px solid var(--amber); outline-offset: 1px; }
.newsletter .btn { border-radius: 5px; background: var(--brand); }
.newsletter .btn:hover { background: var(--brand-dark); }
.footer-cols {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 32px;
  padding: 36px 0;
}
.footer-cols h4 { font-size: 22px; font-weight: 600; margin-bottom: 16px; }
.footer-cols ul { list-style: none; }
.footer-cols li { margin-bottom: 12px; font-size: 16px; opacity: 0.9; }
.footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
  padding-top: 8px;
  font-size: 13px;
  opacity: 0.75;
}

/* ---------- responsive ---------- */
@media (max-width: 1160px) {
  .wrap { padding: 0 28px; }
  .reason .wrap, .reason.flip .wrap, .intro .wrap { gap: 36px; }
}

@media (max-width: 880px) {
  .hero .wrap,
  .intro .wrap,
  .reason .wrap,
  .reason.flip .wrap {
    grid-template-columns: minmax(0, 1fr);
    justify-items: stretch;
  }
  .hero .wrap { gap: 20px; padding-top: 20px; padding-bottom: 20px; }
  /* reference mobile order: label + title, image, then body copy */
  .reason .wrap,
  .reason.flip .wrap {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: none;
    grid-template-areas:
      "head"
      "media"
      "body";
    row-gap: 12px;
  }
  /* mobile type scale */
  .reason-label { font-size: 24px; margin-bottom: 8px; }
  .reason-head h2 { font-size: 21px; line-height: 1.3; margin-bottom: 4px; }
  .reason-body p, .intro p { font-size: 16px; line-height: 1.5; margin-bottom: 12px; }
  .hero-sub { font-size: 16px; margin-top: 12px; }
  .kicker { font-size: 13px; margin-bottom: 8px; }
  .hero h1 { font-size: 24px; }
  .frentes li, .oferta-lista li { font-size: 16px; line-height: 1.45; }
  .reviews h2 { font-size: 22px; }
  .review-title { font-size: 17px; }
  .review-card blockquote { font-size: 15px; line-height: 1.5; }
  .reviews-intro, .reviews-closing { font-size: 15px; }
  .reviews-rating { font-size: 14px; }
  .closing-line { font-size: 20px; }
  .closing-guarantee { font-size: 15px; }
  .reason { padding: 26px 0; }
  .reason.no-media .wrap { max-width: none; }
  .intro .wrap { padding-top: 28px; padding-bottom: 28px; }
  .review-grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; gap: 14px; margin-left: -18px; margin-right: -18px; padding: 4px 18px 12px; }
  .review-card { flex: 0 0 84%; scroll-snap-align: center; }
  .footer-top { grid-template-columns: minmax(0, 1fr); gap: 32px; }
  .footer-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .promo { gap: 12px; min-height: 56px; }
  .promo strong { font-size: 16px; }
}

@media (max-width: 480px) {
  .wrap { padding: 0 18px; }
  .footer-cols { grid-template-columns: minmax(0, 1fr); }
  .reason-label { font-size: 22px; }
  .reason-head h2 { font-size: 20px; }
  .hero h1 { font-size: 23px; }
  .footer-brand { font-size: 40px; }
}

/* ---------- v5 founder copy additions ---------- */
.kicker {
  font-family: var(--font-brand);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  font-size: 15px;
  color: var(--brand);
  margin-bottom: 12px;
}
.hero-sub {
  font-size: 18px;
  line-height: 1.5;
  margin-top: 16px;
  max-width: 56ch;
  color: var(--ink);
}
.hero-cta {
  display: inline-block;
  margin-top: 18px;
  font-weight: 700;
  font-size: 16px;
  color: var(--brand);
  text-decoration: none;
  border-bottom: 2px solid var(--amber-soft);
  padding-bottom: 2px;
}
.hero-cta:hover { color: var(--brand-dark); border-color: var(--brand); }
.hero-cta:focus-visible { outline: 3px solid var(--amber); outline-offset: 2px; }

/* reasons without an image slot: single centered text column */
.reason.no-media .wrap {
  display: block;
  max-width: 820px;
  margin: 0 auto;
}
.reason.no-media .reason-body p { max-width: 62ch; }

/* the three fronts list (reason 6) */
.frentes {
  list-style: none;
  margin: 4px 0 14px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.frentes li {
  font-size: 18px;
  line-height: 1.5;
  padding-left: 18px;
  border-left: 3px solid var(--amber);
  max-width: 62ch;
}

/* offer list (reason 10) */
.oferta-lista {
  list-style: none;
  margin-bottom: 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.oferta-lista li {
  font-size: 18px;
  line-height: 1.5;
  padding-left: 18px;
  border-left: 3px solid var(--brand);
}

/* compact guarantee seal inside reason 10 */
.seal-small { width: 170px; margin: 22px 0 6px; }
.seal-small svg { width: 100%; height: auto; }

/* closing block */
.closing {
  background: var(--cream);
  text-align: center;
  padding: 52px 0;
}
.closing-line {
  font-size: 26px;
  line-height: 1.35;
  font-weight: 400;
  color: var(--black);
  max-width: 30ch;
  margin: 0 auto 18px;
  text-wrap: balance;
}
.closing-guarantee {
  font-size: 17px;
  line-height: 1.5;
  max-width: 52ch;
  margin: 0 auto 26px;
}

@media (max-width: 880px) {
  .closing { padding: 48px 0; }
  .closing-line { font-size: 22px; }
  .seal-small { width: 150px; }
}

/* ---------- clean guarantee stamp (replaces ring-text SVG) ---------- */
.seal-small {
  width: 100%;
  display: flex;
  justify-content: center;
  margin: 26px 0 10px;
}
.stamp {
  width: 200px;
  aspect-ratio: 1;
  border-radius: 50%;
  border: 3px solid var(--brand);
  box-shadow: inset 0 0 0 6px var(--white), inset 0 0 0 7px rgba(193, 83, 26, 0.45);
  background: var(--white);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  text-align: center;
  padding: 20px;
  transform: rotate(-4deg);
}
.reason.flip .stamp { background: var(--cream); box-shadow: inset 0 0 0 6px var(--cream), inset 0 0 0 7px rgba(193, 83, 26, 0.45); }
.stamp-top {
  font-family: var(--font-brand);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 14px;
  color: var(--brand);
}
.stamp-big {
  font-family: var(--font-brand);
  font-weight: 700;
  text-transform: uppercase;
  font-size: 44px;
  line-height: 1;
  color: var(--brand);
}
.stamp-bottom { font-size: 12px; line-height: 1.35; color: var(--ink); }

/* ---------- buy box ---------- */
.buybox { background: var(--white); padding: 64px 0; border-top: 1px solid rgba(0,0,0,0.07); }
.buybox-grid {
  display: grid;
  grid-template-columns: minmax(0, 620px) minmax(0, 640px);
  justify-content: space-between;
  gap: 56px;
  align-items: start;
}
.bb-main { aspect-ratio: 1 / 0.86; background: var(--cream); }
.bb-main img { width: 100%; height: 100%; object-fit: cover; }
.bb-thumbs { display: flex; gap: 10px; margin-top: 10px; }
.bb-thumb {
  flex: 1 1 0;
  aspect-ratio: 1;
  padding: 0;
  border: 2px solid transparent;
  border-radius: 6px;
  overflow: hidden;
  cursor: pointer;
  background: none;
}
.bb-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.bb-thumb.is-active { border-color: var(--brand); }
.bb-thumb:focus-visible { outline: 3px solid var(--amber); outline-offset: 2px; }
.bb-review { background: var(--cream); border-radius: 10px; padding: 18px 20px; margin-top: 18px; }
.bb-review-head { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; font-size: 15px; }
.bb-verified { color: var(--brand); font-weight: 600; font-size: 13px; }
.bb-review blockquote { font-size: 15px; line-height: 1.5; color: rgba(0,0,0,0.8); }

.bb-eyebrow { font-size: 14px; font-weight: 600; color: var(--brand); letter-spacing: 0.03em; margin-bottom: 8px; }
.bb-panel h2 { font-size: 34px; line-height: 1.1; font-weight: 800; color: var(--black); margin-bottom: 14px; }
.bb-desc { font-size: 17px; line-height: 1.5; margin-bottom: 22px; max-width: 60ch; }
.bb-divider {
  display: flex; align-items: center; gap: 14px;
  font-family: var(--font-brand); font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em;
  font-size: 15px; color: var(--ink); margin-bottom: 14px;
}
.bb-divider::before, .bb-divider::after { content: ""; flex: 1; height: 1px; background: rgba(0,0,0,0.25); }

.bb-tiers { display: flex; flex-direction: column; gap: 12px; margin-bottom: 14px; }
.bb-tier {
  position: relative;
  display: grid;
  grid-template-columns: auto auto 1fr auto;
  align-items: center;
  gap: 12px;
  border: 1.5px solid rgba(0,0,0,0.18);
  border-radius: 12px;
  padding: 16px 18px;
  cursor: pointer;
  background: var(--white);
}
.bb-tier input { position: absolute; opacity: 0; }
.bb-tier-img { width: 56px; height: 56px; object-fit: cover; border-radius: 8px; }
.bb-radio {
  width: 22px; height: 22px; border-radius: 50%;
  border: 2px solid rgba(0,0,0,0.3);
  display: inline-block; position: relative;
}
.bb-tier input:checked ~ .bb-radio { border-color: var(--brand); }
.bb-tier input:checked ~ .bb-radio::after {
  content: ""; position: absolute; inset: 3px; border-radius: 50%; background: var(--brand);
}
.bb-tier:has(input:checked) { border: 2.5px solid var(--brand); }
.bb-tier input:focus-visible ~ .bb-radio { outline: 3px solid var(--amber); outline-offset: 2px; }
.bb-tier-name { font-size: 17px; }
.bb-tier-name small { display: block; font-size: 13px; color: rgba(0,0,0,0.55); margin-top: 2px; }
.bb-tier-price { font-size: 20px; }
.bb-tier-strip {
  grid-column: 1 / -1;
  background: var(--cream-deep);
  margin: 10px -18px -16px;
  padding: 10px 18px;
  border-radius: 0 0 10px 10px;
  font-size: 14px;
  font-weight: 600;
}
.bb-pop {
  position: absolute;
  top: -11px; right: 14px;
  background: var(--brand);
  color: var(--white);
