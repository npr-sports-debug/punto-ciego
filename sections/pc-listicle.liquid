<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@700;800&family=Red+Hat+Text:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* Punto Ciego — listicle, estilo editorial TrueClean
   Tokens medidos en la referencia (truecleanhome.com/pages/swooshnshine):
   shell 980px · reason grid 270px/1fr gap 25px · stack gap 34px
   H1 54/800 · H2 42/800 lh1.08 · body 17/1.42 · alert #ffe9e9 + 8px #d30101
   checks #15a34a · botón #1e1e1e r8 · marquee oscuro · oferta bg crema */

:root{
  --ink:#181818;
  --body:#26211b;
  --muted:#6b6157;
  --brand:#c1531a;
  --amber:#e08a3c;
  --cream:#faf5ea;
  --cream-deep:#f5ecdd;
  --alert-bg:#ffe9e9;
  --alert-red:#d30101;
  --ok:#15a34a;
  --no:#e5484d;
  --line:#d9dde0;
  --btn:#1e1e1e;
  --fd:"Red Hat Display","Red Hat Text",-apple-system,sans-serif;
  --ft:"Red Hat Text",-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
}

*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:var(--ft);font-size:17px;line-height:1.42;color:var(--ink);background:#fff;-webkit-font-smoothing:antialiased}
img{display:block;max-width:100%;height:auto}
strong{font-weight:700}

.skip-link{position:absolute;left:-9999px}
.skip-link:focus{left:12px;top:12px;background:var(--btn);color:#fff;padding:10px 14px;z-index:50}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}

/* botón: negro, radio 8, como la referencia */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--btn);color:#fff;font-family:var(--ft);font-weight:700;font-size:19px;text-decoration:none;padding:14px 26px;min-height:52px;border:0;border-radius:8px;cursor:pointer}
.btn:hover{background:#000}
.btn:focus-visible{outline:3px solid var(--amber);outline-offset:2px}

/* header */
.site-head{background:var(--cream);padding:16px 0;text-align:center}
.site-logo{font-family:var(--fd);font-weight:800;font-size:22px;letter-spacing:.02em;color:var(--ink)}
.site-logo span{color:var(--brand)}

/* shell */
.shell{max-width:980px;margin:0 auto;padding:40px 16px 56px}

h1{font-family:var(--fd);font-weight:800;font-size:clamp(32px,5vw,54px);line-height:1.11;max-width:800px;margin-bottom:18px;text-wrap:balance}

/* byline */
.author{display:grid;grid-template-columns:44px 1fr;gap:2px 12px;align-items:center;margin-bottom:26px}
.author-avatar{grid-row:1/3;width:44px;height:44px;border-radius:50%;object-fit:cover}
.author-line{font-size:16px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.verified-pill{border:1px solid var(--line);border-radius:999px;padding:2px 10px;font-size:13px;font-weight:600;color:var(--ink)}
.author-date{font-size:12px;font-style:italic;color:var(--muted)}

/* alerta */
.alert{background:var(--alert-bg);border-left:8px solid var(--alert-red);padding:12px 14px 11px 16px;font-size:16px;font-weight:500;margin-bottom:26px}

/* lede */
.lede{max-width:800px;margin-bottom:30px}
.lede p{margin-bottom:10px;font-size:17px;line-height:1.42}

/* comparativa */
.cmp{border:1px solid var(--line);border-radius:14px;overflow:hidden;margin-bottom:44px;font-size:18px;line-height:1.25}
.cmp-row{display:grid;grid-template-columns:1fr 1.25fr 1.1fr}
.cmp-row+.cmp-row .cmp-cell{border-top:1px solid var(--line)}
.cmp-cell{padding:13px 16px;display:flex;align-items:center;gap:9px}
.cmp-cell.is-center{background:#f2f9f4;border-left:1px solid var(--line);border-right:1px solid var(--line);font-weight:600}
.cmp-head .cmp-cell{background:#f4f6f7;font-weight:700;font-size:18px}
.cmp-head .cmp-cell.is-center{background:var(--btn);color:#fff}
.cmp-logo{font-family:var(--fd);font-weight:800;font-size:17px;color:#fff}
.cmp-logo span{color:var(--amber)}
.ic{width:21px;height:21px;flex:0 0 21px}
.ic circle{fill:var(--ok)}
.ic path{fill:none;stroke:#fff;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.ic.no circle{fill:var(--no)}

.tldr{font-size:15px;color:var(--ink);margin-bottom:44px}

/* razones */
.reasons{display:flex;flex-direction:column;gap:44px}
.reason{display:grid;grid-template-columns:270px 1fr;gap:14px 25px;align-items:start}
.reason h2{grid-column:2;font-family:var(--fd);font-weight:800;font-size:clamp(26px,3.4vw,42px);line-height:1.08;text-wrap:balance}
.reason-media{grid-column:1;grid-row:1/3}
.reason-media img{width:270px;aspect-ratio:1;object-fit:cover;border-radius:12px}
.reason-body{grid-column:2}
.reason-body p{margin-bottom:12px;max-width:64ch}
.reason-body p:last-child{margin-bottom:0}
.reason-body .btn{margin-top:6px}

.frentes{list-style:none;margin:0 0 12px;display:grid;gap:8px}
.frentes li{padding-left:20px;position:relative;max-width:64ch}
.frentes li::before{content:"✓";position:absolute;left:0;color:var(--ok);font-weight:800}

/* prueba social dentro de razón 8 */
.stars-line{font-size:16px;font-weight:700;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.stars{color:var(--amber);letter-spacing:2px;font-size:18px}
.review{border-left:3px solid var(--line);padding:2px 0 2px 16px;margin:0 0 14px}
.review p{font-size:16px;line-height:1.4;margin-bottom:6px}
.review footer{font-size:16px;font-weight:400;color:var(--muted)}
.verified{color:var(--ok);font-weight:700}
.under-btn{font-size:14px;color:var(--muted);margin-top:8px}

/* muro de fotos */
.wall{background:#211c16;color:#f4ece3;padding:56px 0 60px;overflow:hidden}
.wall-head{max-width:980px;margin:0 auto 30px;padding:0 16px}
.wall-kicker{font-family:var(--fd);font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:14px;color:var(--amber);margin-bottom:8px}
.wall h2{font-family:var(--fd);font-weight:800;font-size:clamp(30px,3.4vw,42px);line-height:1.08;color:#fff;text-transform:uppercase}
.wall-sub{font-size:17px;color:#c9bcae;margin-top:8px}
.wall-rows{display:grid;gap:14px}
.wall-row{overflow:hidden}
.wall-track{display:flex;gap:14px;width:max-content;animation:wall-scroll 48s linear infinite}
.wall-row.is-reverse .wall-track{animation-direction:reverse}
.wall-track--slow{animation-duration:56s}
.wall-track img{width:220px;aspect-ratio:1;object-fit:cover;border-radius:12px;flex:0 0 auto}
@keyframes wall-scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.wall-track{animation:none}}
.wall-foot{max-width:980px;margin:34px auto 0;padding:0 16px;display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap}
.wall-line{font-family:var(--fd);font-weight:800;font-size:clamp(24px,2.6vw,34px);line-height:1.1;color:#fff;text-transform:uppercase;max-width:22ch}
.wall .btn{background:var(--brand)}
.wall .btn:hover{background:#9c3f0f}

/* marquee */
.marquee{background:#211c16;overflow:hidden}
.marquee-track{display:flex;gap:28px;padding:26px 0;white-space:nowrap;color:#fff;font-size:18px;font-weight:700;animation:marquee 28s linear infinite;width:max-content}
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion: reduce){.marquee-track{animation:none}}

/* oferta */
.offer{background:var(--cream-deep);padding:56px 0 64px}
.offer-wrap{max-width:980px;margin:0 auto;padding:0 16px}
.offer-kicker{text-align:center;font-family:var(--fd);font-weight:600;font-size:19px;margin-bottom:26px}
.buybox-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:36px;align-items:start}

.bb-main img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:14px}
.bb-thumbs{display:flex;gap:10px;margin-top:10px}
.bb-thumb{flex:1;aspect-ratio:1;padding:0;border:2px solid transparent;border-radius:8px;overflow:hidden;cursor:pointer;background:none}
.bb-thumb.is-active{border-color:var(--btn)}
.bb-thumb img{width:100%;height:100%;object-fit:cover}
.bb-review{background:#fff;border-radius:12px;padding:16px 18px;margin-top:14px}
.bb-review-head{display:flex;align-items:center;gap:10px;font-size:14px;margin-bottom:8px}
.bb-review-avatar{width:34px;height:34px;border-radius:50%;object-fit:cover}
.bb-verified{color:var(--muted);font-size:13px}
.bb-review blockquote{font-size:15.5px;line-height:1.45}

.bb-eyebrow{font-family:var(--fd);font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:.1em;color:var(--brand);margin-bottom:8px}
.bb-panel h2{font-family:var(--fd);font-weight:800;font-size:30px;line-height:1.08;margin-bottom:10px}
.bb-desc{font-size:15px;line-height:1.32;margin-bottom:18px}
.bb-divider{display:flex;align-items:center;gap:12px;font-family:var(--fd);font-weight:700;text-transform:uppercase;letter-spacing:.12em;font-size:13px;margin-bottom:12px}
.bb-divider::before,.bb-divider::after{content:"";flex:1;height:1px;background:rgba(0,0,0,.22)}

.bb-tiers{display:grid;gap:12px;margin-bottom:12px}
.bb-tier{position:relative;display:grid;grid-template-columns:auto auto 1fr auto;align-items:center;gap:12px;border:1.5px solid rgba(0,0,0,.18);border-radius:12px;padding:14px 16px;cursor:pointer;background:#fff}
.bb-tier input{position:absolute;opacity:0}
.bb-tier:has(input:checked){border:2.5px solid var(--btn)}
.bb-tier:has(input:focus-visible){outline:3px solid var(--amber);outline-offset:2px}
.bb-radio{width:22px;height:22px;border-radius:50%;border:2px solid rgba(0,0,0,.3);position:relative}
.bb-tier input:checked~.bb-radio{border-color:var(--btn)}
.bb-tier input:checked~.bb-radio::after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--btn)}
.bb-tier-img{width:56px;height:56px;object-fit:cover;border-radius:8px}
.bb-tier-name{font-size:16.5px;line-height:1.3}
.bb-supply{display:inline-block;background:rgba(0,0,0,.07);border-radius:999px;padding:1px 9px;font-size:12px;font-weight:600;margin-left:6px;vertical-align:1px;color:var(--muted)}
.bb-tier-name small{display:block;font-size:13.5px;color:var(--muted);margin-top:3px}
.bb-tier-price{font-size:20px;font-weight:700}
.bb-pop{position:absolute;top:-11px;right:14px;background:var(--btn);color:#fff;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;padding:3px 10px;border-radius:4px}
.bb-pop--value{background:var(--brand)}
.bb-tier-strip{grid-column:1/-1;font-size:13.5px;color:var(--body);background:var(--cream);border-radius:8px;padding:7px 10px}

.bb-subscribe{position:relative;display:grid;grid-template-columns:auto 1fr;align-items:center;gap:12px;border:2px dashed var(--brand);border-radius:12px;padding:12px 16px;cursor:pointer;margin-bottom:10px;background:#fff}
.bb-subscribe input{position:absolute;opacity:0}
.bb-subscribe:has(input:focus-visible){outline:3px solid var(--amber);outline-offset:2px}
.bb-check{width:22px;height:22px;border-radius:5px;border:2px solid var(--brand);position:relative}
.bb-subscribe input:checked~.bb-check::after{content:"✓";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--brand);font-weight:800;font-size:15px}
.bb-subscribe strong{display:block;font-size:15.5px}
.bb-subscribe small{display:block;font-size:13.5px;color:var(--muted);margin-top:2px}

.bb-pill{text-align:center;font-size:12px;font-weight:700;color:var(--muted);margin:10px 0 12px}
.bb-cta{width:100%;font-size:24px;min-height:60px}
.bb-note{text-align:center;font-size:15px;line-height:1.45;color:var(--body);margin-top:10px}
.pay-badges{display:flex;justify-content:center;gap:8px;margin-top:12px}
.pay-badge{width:54px;height:34px;border:1px solid rgba(0,0,0,.14);border-radius:6px;display:inline-flex;align-items:center;justify-content:center;background:#fff;overflow:hidden}
.pay-badge svg{width:100%;height:100%}

/* cierre */
.closing{max-width:760px;margin:0 auto;padding:64px 16px;text-align:center}
.closing-line{font-family:var(--fd);font-weight:800;font-size:clamp(30px,3.4vw,42px);line-height:1.1;margin-bottom:14px;text-wrap:balance}
.closing-guarantee{font-size:17px;margin-bottom:22px}

/* footer */
.footer{background:#211c16;color:#f4ece3;padding:48px 0 28px}
.footer .wrap{max-width:980px;margin:0 auto;padding:0 16px}
.footer-top{display:grid;grid-template-columns:1fr 1fr;gap:36px;margin-bottom:36px}
.footer-brand{font-family:var(--fd);font-weight:800;text-transform:uppercase;font-size:30px;line-height:1;color:#fff}
.footer-brand small{display:block;font-size:12px;letter-spacing:.14em;margin-top:6px;color:#c9bcae}
.footer-tagline{color:#c9bcae;margin-top:10px}
.newsletter h3{font-family:var(--fd);font-weight:800;font-size:18px;color:#fff;margin-bottom:6px}
.newsletter p{font-size:14px;color:#c9bcae;margin-bottom:12px}
.newsletter form{display:flex;gap:8px}
.newsletter input{flex:1;min-width:0;padding:12px 14px;border:1px solid rgba(255,255,255,.25);border-radius:8px;background:rgba(255,255,255,.06);color:#fff;font-size:15px;font-family:var(--ft)}
.newsletter input::placeholder{color:#a3968a}
.newsletter .btn{background:var(--brand);font-size:15px;min-height:46px;padding:10px 18px}
.newsletter .btn:hover{background:#9c3f0f}
.footer-cols{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-bottom:32px}
.footer-cols h4{font-size:13px;text-transform:uppercase;letter-spacing:.1em;color:#c9bcae;margin-bottom:10px}
.footer-cols ul{list-style:none}
.footer-cols li{margin-bottom:7px}
.footer-cols a{color:#f4ece3;text-decoration:none;font-size:14.5px}
.footer-cols a:hover{color:var(--amber)}
.footer-bottom{display:flex;justify-content:space-between;align-items:center;gap:14px;border-top:1px solid rgba(255,255,255,.12);padding-top:20px;font-size:13px;color:#c9bcae;flex-wrap:wrap}
.footer-bottom .pay-badges{margin-top:0}
.footer-bottom .pay-badge{background:#fff;border-color:transparent}

/* ===== mobile ===== */
@media (max-width:749px){
  body{font-size:16px}
  .shell{padding:26px 16px 40px}
  h1{font-size:30px;line-height:1.02;margin-bottom:14px}
  .lede p{font-size:14px;line-height:1.3}
  .cmp{font-size:11px;line-height:1.25;border-radius:12px}
  .cmp-cell{padding:10px 8px;gap:6px}
  .cmp-head .cmp-cell{font-size:11px}
  .cmp-logo{font-size:14px}
  .ic{width:17px;height:17px;flex-basis:17px}
  .tldr{margin-bottom:34px}
  .reasons{gap:38px}
  .reason{grid-template-columns:1fr;gap:12px}
  .reason h2,.reason-body{grid-column:1}
  .reason-media{grid-column:1;grid-row:auto}
  .reason-media img{width:100%;max-height:340px;aspect-ratio:auto;height:auto;object-fit:cover}
  .reason h2{font-size:30px;line-height:1.04}
  .reason-body p,.frentes li{font-size:14px;line-height:1.3}
  .btn{font-size:15px;min-height:46px}
  .review p{font-size:13px;line-height:1.4}
  .review footer{font-size:13px}
  .reason-body p.stars-line{font-size:13px}
  .stars{font-size:15px}
  .marquee-track{font-size:13px;padding:20px 0}
  .bb-desc{font-size:15px}
  .bb-cta{font-size:16px;min-height:52px}
  .bb-note{font-size:13px}
  .closing-line{font-size:30px}
  .reason-body .btn{width:100%}
  .buybox-grid{grid-template-columns:1fr;gap:18px}
  .offer{padding:36px 0 44px}
  .offer-kicker{font-size:14px;margin-bottom:18px}
  .bb-panel h2{font-size:30px}
  .bb-tier-name{font-size:15.5px}
  .bb-tier-price{font-size:18px}
  .closing{padding:44px 16px}
  .footer-top{grid-template-columns:1fr;gap:26px}
  .footer-cols{grid-template-columns:repeat(2,1fr)}
  .footer-bottom{justify-content:center;text-align:center}
}

/* muro mobile */
@media (max-width:749px){
  .wall{padding:36px 0 40px}
  .wall h2{font-size:30px}
  .wall-sub{font-size:14px}
  .wall-rows{gap:10px}
  .wall-track{gap:10px}
  .wall-track img{width:150px}
  .wall-foot{margin-top:26px;flex-direction:column;align-items:flex-start}
  .wall-line{font-size:24px}
  .wall .btn{width:100%}
}

</style>


