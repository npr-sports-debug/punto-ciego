<script>
document.querySelectorAll('.bb-thumb').forEach(function(b){
  b.addEventListener('click',function(){
    document.getElementById('bb-main-img').src=b.dataset.img;
    document.querySelectorAll('.bb-thumb').forEach(function(x){x.classList.remove('is-active');});
    b.classList.add('is-active');
  });
});
function bbFreq(){
  var sel=document.querySelector('.bb-tier input:checked');
  if(!sel)return;
  document.getElementById('bb-sub-freq').textContent='Te la reenviamos '+sel.dataset.freq+'.'+(sel.dataset.extra||'')+' Cancelas en un clic, sin cargos sorpresa.';
}
document.querySelectorAll('.bb-tier input').forEach(function(r){r.addEventListener('change',bbFreq);});
bbFreq();
var tc=document.getElementById('tcarousel');
document.querySelectorAll('.tarrow').forEach(function(b){
  b.addEventListener('click',function(){
    var card=tc.querySelector('.tcard2');
    tc.scrollBy({left:(card.offsetWidth+16)*Number(b.dataset.dir),behavior:'smooth'});
  });
});
</script>

