    main.classList.add('is-fading');
    window.setTimeout(function(){
      var done=function(){main.classList.remove('is-fading');main.removeEventListener('load',done);};
      main.addEventListener('load',done);
      main.src=t.getAttribute('data-src');
      main.alt=t.getAttribute('data-alt');
      if(main.complete)done();
    },150);
    /* keep active thumb in view (horizontal only — no page jump) */
    var left=t.offsetLeft-strip.offsetLeft;
    var target=left-(strip.clientWidth-t.offsetWidth)/2;
    strip.scrollTo({left:Math.max(0,target),behavior:'smooth'});
    preload(i+1);preload(i-1);
  }
  thumbs.forEach(function(b,i){
    b.addEventListener('click',function(){show(i);});
  });
  /* keyboard: arrows work when focus is anywhere inside the gallery */
  gal.addEventListener('keydown',function(e){
    if(e.key==='ArrowRight'){e.preventDefault();show(idx+1);}
    else if(e.key==='ArrowLeft'){e.preventDefault();show(idx-1);}
  });
  /* swipe on the main image */
  var sx=null,sy=null;
  var mainWrap=gal.querySelector('.gallery__main');
  mainWrap.addEventListener('touchstart',function(e){
    sx=e.touches[0].clientX;sy=e.touches[0].clientY;
  },{passive:true});
  mainWrap.addEventListener('touchend',function(e){
    if(sx===null)return;
    var dx=e.changedTouches[0].clientX-sx;
    var dy=e.changedTouches[0].clientY-sy;
    sx=sy=null;
    if(Math.abs(dx)>40&&Math.abs(dx)>Math.abs(dy)){
      show(idx+(dx<0?1:-1));
    }
  },{passive:true});
  preload(1);preload(n-1);
})();

/* ═══ Testimonial carousels — scroll-snap + dots/arrows (no library) ═══ */
(function(){
  var mqDesk=window.matchMedia('(min-width:1024px)');
  document.querySelectorAll('[data-carousel]').forEach(function(track){
    var cards=Array.prototype.slice.call(track.querySelectorAll(':scope > .tcard'));
    if(cards.length<2)return;
    var nav=document.createElement('div');
    nav.className='tnav';
    var prev=document.createElement('button');
    prev.type='button';prev.className='tnav__btn';prev.setAttribute('aria-label','Opinión anterior');
    prev.innerHTML='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg>';
    var next=document.createElement('button');
    next.type='button';next.className='tnav__btn';next.setAttribute('aria-label','Siguiente opinión');
    next.innerHTML='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>';
    var dotsWrap=document.createElement('div');
    dotsWrap.className='tnav__dots';
    var dots=cards.map(function(c,i){
      var d=document.createElement('button');
      d.type='button';d.className='tnav__dot';
      d.setAttribute('aria-label','Ir a la opinión '+(i+1)+' de '+cards.length);
      if(i===0)d.setAttribute('aria-current','true');
      d.addEventListener('click',function(){goTo(i);});
      dotsWrap.appendChild(d);
      return d;
    });
    nav.appendChild(prev);nav.appendChild(dotsWrap);nav.appendChild(next);
    track.parentNode.insertBefore(nav,track.nextSibling);
    var cur=0;
    function goTo(i){
      i=Math.max(0,Math.min(cards.length-1,i));
      var c=cards[i];
      track.scrollTo({left:c.offsetLeft-track.offsetLeft-(track.clientWidth-c.offsetWidth)/2,behavior:'smooth'});
    }
    prev.addEventListener('click',function(){goTo(cur-1);});
    next.addEventListener('click',function(){goTo(cur+1);});
    var raf=null;
    track.addEventListener('scroll',function(){
      if(raf)return;
      raf=window.requestAnimationFrame(function(){
        raf=null;
        if(mqDesk.matches)return;
        var mid=track.scrollLeft+track.clientWidth/2,best=0,bd=Infinity;
        cards.forEach(function(c,i){
          var d=Math.abs((c.offsetLeft-track.offsetLeft)+c.offsetWidth/2-mid);
          if(d<bd){bd=d;best=i;}
        });
        if(best!==cur){
          cur=best;
          dots.forEach(function(d,i){
            if(i===cur)d.setAttribute('aria-current','true');
            else d.removeAttribute('aria-current');
          });
        }
      });
    },{passive:true});
  });
})();

/* ═══ Accordions — aria mirror + desktop auto-expand ═══ */
(function(){
  var accs=Array.prototype.slice.call(document.querySelectorAll('details.acc'));
  accs.forEach(function(d){
    var s=d.querySelector('summary');
    if(!s)return;
    s.setAttribute('aria-expanded',d.open?'true':'false');
    d.addEventListener('toggle',function(){s.setAttribute('aria-expanded',d.open?'true':'false');});
    if(d.open)d.setAttribute('data-default-open','');
  });
  var autos=accs.filter(function(d){return d.classList.contains('acc--auto');});
  var mq=window.matchMedia('(min-width:1024px)');
  function apply(){
    autos.forEach(function(d){
      if(mq.matches){d.open=true;d.classList.add('is-static');}
      else{d.classList.remove('is-static');d.open=d.hasAttribute('data-default-open');}
    });
  }
  apply();
  if(mq.addEventListener)mq.addEventListener('change',apply);
  else if(mq.addListener)mq.addListener(apply);
  var lastMatch=mq.matches,rt=null;
  window.addEventListener('resize',function(){
    if(rt)clearTimeout(rt);
    rt=setTimeout(function(){
      if(mq.matches!==lastMatch){lastMatch=mq.matches;apply();}
    },120);
  });
})();

/* ═══ Video clips — nudge autoplay (muted + playsinline already set) ═══ */
(function(){
  var vids=Array.prototype.slice.call(document.querySelectorAll('.vid-fig video'));
  function nudge(v){
    v.muted=true;
    var p=v.play();
    if(p&&p.catch)p.catch(function(){});
  }
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if(en.isIntersecting&&en.target.paused)nudge(en.target);
      });
    },{rootMargin:'120px 0px'});
    vids.forEach(function(v){io.observe(v);});
  }
  vids.forEach(nudge);
})();
</script>
