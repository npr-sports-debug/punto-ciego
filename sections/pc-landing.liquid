<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Barlow+Condensed:wght@600;700&display=swap" rel="stylesheet">
<style>
/* Punto Ciego landing v3 — light base, 3 dark accents (hero / mecanismo / garantía+footer) */
:root{
  --ink:#26211b;--ink2:#5b5045;--head:#16120e;
  --brand:#c1531a;--brand-dk:#9c3f0f;--amber:#e08a3c;--amber-soft:#f2c18f;
  --cream:#f5ecdd;--white:#fff;--dark:#171310;--dark2:#221c17;--on-dark:#f4ece3;--on-dark2:#c9bcae;
  --fb:"Inter",-apple-system,"Segoe UI",Roboto,Arial,sans-serif;--fd:"Barlow Condensed","Arial Narrow",var(--fb);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:var(--fb);font-size:17px;line-height:1.55;color:var(--ink);background:var(--white);-webkit-font-smoothing:antialiased}
img{display:block;max-width:100%;height:auto}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
.narrow{max-width:760px}
.center{text-align:center}
h1,h2,h3{color:var(--head);line-height:1.2;text-wrap:balance}
h2{font-size:clamp(24px,2.6vw,32px);font-weight:800;margin-bottom:16px}
h3{font-size:20px;font-weight:700;margin:12px 0 6px}
p{max-width:62ch}
.center p,.center h2{margin-left:auto;margin-right:auto}
strong{font-weight:700;color:inherit}
.lead{font-size:19px;line-height:1.5}
.sub{color:var(--ink2);margin-bottom:24px}
.eyebrow{font-family:var(--fd);font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:14px;color:var(--brand);margin-bottom:10px}
.kicker{font-family:var(--fd);font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:14px;color:var(--amber);margin-bottom:12px}

.skip{position:absolute;left:-9999px}.skip:focus{left:12px;top:12px;background:var(--brand);color:#fff;padding:10px 14px;z-index:50}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--brand);color:#fff;font-weight:700;font-size:15px;letter-spacing:.03em;text-transform:uppercase;text-decoration:none;padding:14px 26px;min-height:48px;border:0;border-radius:10px;cursor:pointer}
.btn:hover{background:var(--brand-dk)}
.btn:focus-visible{outline:3px solid var(--amber);outline-offset:2px}
.btn.big{width:100%;font-size:17px;min-height:56px}

.topbar{position:sticky;top:0;z-index:40;background:var(--dark);color:var(--on-dark);display:flex;justify-content:center;gap:22px;align-items:center;padding:10px 16px;font-size:14px}
.topbar a{color:var(--amber);font-weight:700;text-decoration:none}

.dark{background:var(--dark);color:var(--on-dark)}
.dark h1,.dark h2,.dark h3{color:#fff}
.dark .lead,.dark p{color:var(--on-dark2)}
.dark strong{color:#fff}
.tint{background:var(--cream)}

/* hero */
.hero{padding:56px 0 48px}
.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center}
.hero h1{font-size:clamp(30px,3.6vw,46px);font-weight:800;margin-bottom:16px}
.hero h1 span{color:var(--amber)}
.hero .lead{margin-bottom:22px}
.micro{font-size:14px;color:var(--on-dark2);margin-top:10px}
.hero-fig img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:16px;box-shadow:0 30px 60px rgba(0,0,0,.5)}

/* quotes strip */
.quotes{padding:40px 0;border-bottom:1px solid rgba(0,0,0,.07)}
.qgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.qgrid blockquote{background:var(--cream);border-radius:12px;padding:20px 22px;font-size:16px;line-height:1.5}
.qgrid footer{margin-top:10px;font-weight:700;font-size:14px;color:var(--brand)}

/* blocks */
.block{padding:64px 0}
.two{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
.two.flip>figure{order:-1}
.fig img{width:100%;border-radius:14px;aspect-ratio:1;object-fit:cover}
.fig.wide{max-width:860px;margin:28px auto 20px}
.fig.wide img{aspect-ratio:16/9}
.x{list-style:none;margin:14px 0 18px;display:grid;gap:12px}
.x li{padding-left:22px;position:relative}
.x li::before{content:"✕";position:absolute;left:0;color:var(--brand);font-weight:700}

/* mechanism */
.fronts{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin:36px 0 8px}
.fronts article{background:var(--dark2);border-radius:14px;padding:0 0 20px;overflow:hidden}
.fronts img{width:100%;aspect-ratio:4/3;object-fit:cover}
.fronts h3,.fronts p{padding:0 18px}
.fronts p{font-size:16px}

/* proof */
.tgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.tcard{background:var(--white);border-radius:14px;overflow:hidden;box-shadow:0 1px 6px rgba(0,0,0,.07);display:flex;flex-direction:column}
.tcard img{width:100%;aspect-ratio:4/3.3;object-fit:cover;object-position:50% 20%}
.tcard p{padding:16px 18px 0;font-size:16px;line-height:1.5;flex:1}
.tcard footer{padding:12px 18px 18px;font-weight:700;font-size:14px;color:var(--brand)}
.tcard.noimg{background:var(--dark);color:var(--on-dark);justify-content:center}
.tcard.noimg p{font-size:17px;padding-top:24px}
.tcard.noimg footer{color:var(--amber)}

/* buybox */
.buybox{padding:64px 0;border-top:1px solid rgba(0,0,0,.07)}
.bb-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:48px;align-items:start}
#bb-main{width:100%;aspect-ratio:1;object-fit:cover;border-radius:14px;background:var(--cream)}
.bb-thumbs{display:flex;gap:10px;margin-top:10px}
.bb-thumbs button{flex:1;aspect-ratio:1;padding:0;border:2px solid transparent;border-radius:8px;overflow:hidden;cursor:pointer;background:none}
.bb-thumbs button.is-active{border-color:var(--brand)}
.bb-thumbs img{width:100%;height:100%;object-fit:cover}
.bb-panel h2{font-size:32px;margin-bottom:10px}
.bb-desc{margin-bottom:20px}
.bb-divider{display:flex;align-items:center;gap:12px;font-family:var(--fd);font-weight:700;text-transform:uppercase;letter-spacing:.12em;font-size:14px;margin-bottom:12px}
.bb-divider::before,.bb-divider::after{content:"";flex:1;height:1px;background:rgba(0,0,0,.2)}
.tiers{display:grid;gap:12px;margin-bottom:12px}
.tier{position:relative;display:grid;grid-template-columns:auto auto 1fr auto;align-items:center;gap:12px;border:1.5px solid rgba(0,0,0,.18);border-radius:12px;padding:14px 16px;cursor:pointer;background:#fff}
.tier input{position:absolute;opacity:0}
.tier:has(input:checked){border:2.5px solid var(--brand)}
.tier:has(input:focus-visible){outline:3px solid var(--amber);outline-offset:2px}
.radio{width:22px;height:22px;border-radius:50%;border:2px solid rgba(0,0,0,.3);position:relative}
.tier input:checked~.radio{border-color:var(--brand)}
.tier input:checked~.radio::after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--brand)}
.tier img{width:56px;height:56px;object-fit:cover;border-radius:8px}
.tname{font-size:17px;line-height:1.3}
.tname em{font-style:normal;display:inline-block;background:rgba(0,0,0,.07);border-radius:999px;padding:1px 9px;font-size:12px;font-weight:600;margin-left:6px;vertical-align:1px;color:var(--ink2)}
.tname small{display:block;font-size:14px;color:var(--ink2);margin-top:3px}
.tprice{font-size:20px;font-weight:700}
.pop{position:absolute;top:-11px;right:14px;background:var(--brand);color:#fff;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;padding:3px 10px;border-radius:4px}
.dark-pop{background:var(--head)}
.addon{position:relative;display:grid;grid-template-columns:auto 1fr;align-items:center;gap:12px;border:1.5px solid rgba(0,0,0,.18);border-radius:12px;padding:12px 16px;cursor:pointer;margin-bottom:10px}
.addon.sub{border:2px dashed var(--brand)}
.addon input{position:absolute;opacity:0}
.addon:has(input:focus-visible){outline:3px solid var(--amber);outline-offset:2px}
.check{width:22px;height:22px;border-radius:5px;border:2px solid var(--brand);position:relative}
.addon input:checked~.check::after{content:"✓";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--brand);font-weight:800;font-size:15px}
.addon strong{display:block;font-size:16px}
.addon small{display:block;font-size:14px;color:var(--ink2);margin-top:2px}
.bb-note{text-align:center;font-size:14px;font-weight:600;margin:12px 0 12px;color:var(--ink2)}
.pay{display:flex;justify-content:center;gap:8px}
.pb{width:54px;height:34px;border:1px solid rgba(0,0,0,.14);border-radius:6px;display:inline-flex;align-items:center;justify-content:center;font-weight:900;font-size:12px;background:#fff}
.pb.oxxo{background:#e8b70a;color:#fff;position:relative;overflow:hidden}.pb.oxxo::before{content:"";position:absolute;inset:9px 0;background:#d61118;z-index:0}.pb.oxxo{text-shadow:0 0 2px #d61118}
.pb.visa{color:#1a1f71;font-style:italic;font-size:14px}
.pb.mc i{width:18px;height:18px;border-radius:50%;display:inline-block}.pb.mc i:first-child{background:#eb001b;margin-right:-7px}.pb.mc i:last-child{background:#f79e1b;opacity:.9}

/* guarantee */
.guarantee .stamp{display:inline-block;font-family:var(--fd);font-weight:700;text-transform:uppercase;font-size:22px;letter-spacing:.08em;color:var(--amber);border:3px solid var(--amber);border-radius:999px;padding:8px 22px;margin-bottom:16px;transform:rotate(-3deg)}
.guarantee .lead{margin:0 auto 24px}

/* faq */
details{border:1px solid rgba(0,0,0,.12);border-radius:10px;padding:0 18px;margin-bottom:10px;background:#fff}
summary{cursor:pointer;font-weight:700;padding:16px 0;list-style:none;position:relative;padding-right:28px}
summary::after{content:"+";position:absolute;right:0;color:var(--brand);font-weight:800}
details[open] summary::after{content:"−"}
details p{padding:0 0 16px}

.closing{padding:56px 0}
.big-line{font-size:clamp(22px,2.6vw,30px);font-weight:400;color:var(--head);line-height:1.35;margin:0 auto 22px;max-width:28ch}

.foot{padding:44px 0 28px;text-align:center}
.foot .brand{font-family:var(--fd);font-weight:700;text-transform:uppercase;font-size:34px;letter-spacing:.04em;color:#fff}
.foot .tag{color:var(--on-dark2);margin:6px auto 18px}
.foot nav{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 22px;margin-bottom:16px}
.foot nav a{color:var(--on-dark);text-decoration:none;font-size:14px}
.foot .copy{font-size:13px;color:var(--on-dark2);margin:0 auto}

/* sticky mobile cta */
.sticky{position:fixed;left:0;right:0;bottom:0;z-index:40;background:var(--dark);color:var(--on-dark);display:none;align-items:center;justify-content:space-between;gap:12px;padding:10px 16px;border-top:1px solid rgba(255,255,255,.12)}
.sticky b{display:block;font-size:20px;color:#fff}
.sticky span{font-size:13px;color:var(--on-dark2)}
.sticky .btn{min-height:44px;padding:10px 18px;font-size:14px}

@media (max-width:880px){
  body{font-size:16px}
  .wrap{padding:0 18px}
  .hero{padding:36px 0 32px}
  .hero-grid{grid-template-columns:1fr;gap:22px}
  .hero-fig{order:-1;max-width:300px;margin:0 auto}
  .hero h1{font-size:28px}
  .lead{font-size:17px}
  .qgrid{grid-template-columns:1fr;gap:12px}
  .block{padding:40px 0}
  .two{grid-template-columns:1fr;gap:22px}
  .two.flip>figure{order:0}
  h2{font-size:23px}
  .fronts{grid-template-columns:1fr;gap:14px}
  .fronts img{aspect-ratio:16/9}
  .tgrid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:14px;margin:0 -18px;padding:4px 18px 10px;scrollbar-width:none}
  .tgrid::-webkit-scrollbar{display:none}
  .tcard{flex:0 0 82%;scroll-snap-align:start}
  .bb-grid{grid-template-columns:1fr;gap:22px}
  .bb-panel h2{font-size:26px}
  .tname{font-size:16px}
  .tprice{font-size:18px}
  .sticky.on{display:flex}
  body:has(.sticky.on) .closing{padding-bottom:96px}
}

</style>

