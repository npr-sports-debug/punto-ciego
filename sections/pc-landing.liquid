/* base flips to light; hero/mech/guarantee/bands stay dark */
:root{
  --bg-0:#ffffff; --bg-1:#f7f1e8; --bg-2:#f5ecdd; --bg-bronze:#f3e4d3;
  --ink:#26211b; --ink-soft:#5b5045; --ink-faint:#877a6c;
  --line:rgba(0,0,0,.12); --line-soft:rgba(0,0,0,.07);
  --head:#16120e;
}
.hero,.claimband,.mech,.ctaband,.returnline,.guarantee,.benefitstrip,.promobar,.mcta,.footer{--bg-0:#161210;--bg-1:#1e1815;--bg-2:#100c0a;--bg-bronze:#2a1c12;--ink:#f4ece3;--ink-soft:#c9bcae;--ink-faint:#9a8b7c;--line:rgba(244,236,227,.12);--line-soft:rgba(244,236,227,.07);--head:#ffffff;}
.hero,.claimband,.mech,.ctaband,.returnline,.guarantee,.footer{background:var(--bg-0);color:var(--ink)}
.benefitstrip{background:var(--bg-bronze)}
strong,b{color:var(--head)}
.hero h1{color:var(--head)}
.benefitstrip .item{color:var(--head)}
.claimband h2{color:var(--head)}
.mech__head h2{color:var(--head)}
.mech__block h3{color:var(--head)}
.ctaband h2{color:var(--head)}
.returnline p{color:var(--head)}
.timeline__head h2{color:var(--head)}
.stage__item h4{color:var(--head)}
.proof__quote h2{color:var(--head)}
.tfeat blockquote{color:var(--head)}
.edu h2{color:var(--head)}
.edu .kicker{color:var(--head)}
.offer__head h2{color:var(--head)}
.tier__name{color:var(--head)}
.addon b{color:var(--head)}
.guarantee h2{color:var(--head)}
.guarantee__hero{color:var(--head)}
.guarantee summary{color:var(--head)}
.faq h2{color:var(--head)}
.faq summary{color:var(--head)}
/* legibility touch-ups on light */
.tcard,.stage{box-shadow:0 1px 6px rgba(0,0,0,.07)}
.edu-img{border-radius:12px;overflow:hidden;margin-top:1.6rem;aspect-ratio:16/9}
.edu-img img{width:100%;height:100%;object-fit:cover;display:block}

