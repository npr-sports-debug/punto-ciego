<div class="sticky" id="sticky" aria-hidden="true">
  <div><b id="sticky-price">$299</b><span id="sticky-label">Dúo · 2 barras</span></div>
  <a class="btn" href="#oferta">Probar sin riesgo</a>
</div>

<script>
(function(){
  var form=document.getElementById('bb-form'),cta=document.getElementById('bb-cta'),freq=document.getElementById('sub-freq');
  var sp=document.getElementById('sticky-price'),sl=document.getElementById('sticky-label');
  function sync(){
    var t=form.querySelector('input[name=id]:checked');if(!t)return;
    var price=+t.dataset.price;
    cta.textContent='Agregar al carrito · $'+price;
    freq.textContent='Te la reenviamos '+t.dataset.freq+'. Cancelas en un clic, sin cargos sorpresa.';
    sp.textContent='$'+t.dataset.price;sl.textContent=t.dataset.label;
  }
  form.addEventListener('change',sync);sync();
  var SELLING_PLANS={};
  form.addEventListener('submit',function(e){
    e.preventDefault();
    var t=form.querySelector('input[name=id]:checked');
    if(!t)return;
    var items=[{id:Number(t.value),quantity:1}];
    var sub=form.querySelector('input[name=subscribe]');
    var plan=SELLING_PLANS[t.value];
    if(sub&&sub.checked&&plan){items[0].selling_plan=Number(plan);}
    cta.disabled=true;cta.textContent='Un momento...';
    fetch('/cart/clear.js',{method:'POST'}).then(function(){
      return fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:items})});
    }).then(function(r){
      if(!r.ok)throw new Error('add failed');
      window.location.href='/checkout';
    }).catch(function(){
      cta.disabled=false;cta.textContent='Agregar al carrito';
      window.location.href='/cart/'+t.value+':1';
    });
  });
  document.querySelectorAll('.bb-thumbs button').forEach(function(b){b.addEventListener('click',function(){document.getElementById('bb-main').src=b.dataset.img;document.querySelectorAll('.bb-thumbs button').forEach(function(x){x.classList.remove('is-active');});b.classList.add('is-active');});});
  var sticky=document.getElementById('sticky'),hero=document.querySelector('.hero'),offer=document.getElementById('oferta');
  function onScroll(){var h=hero.getBoundingClientRect().bottom<0,o=offer.getBoundingClientRect();var inOffer=o.top<window.innerHeight&&o.bottom>0;sticky.classList.toggle('on',h&&!inOffer);sticky.setAttribute('aria-hidden',!(h&&!inOffer));}
  window.addEventListener('scroll',onScroll,{passive:true});onScroll();
})();
</script>


