  function preload(i){
    i=((i%n)+n)%n;
    var src=thumbs[i].getAttribute('data-src');
    if(preloaded[src])return;
    preloaded[src]=1;
    var im=new Image();im.src=src;
  }
  function show(i){
    i=((i%n)+n)%n;
    if(i===idx&&main.getAttribute('src')===thumbs[i].getAttribute('data-src'))return;
    idx=i;
    var t=thumbs[i];
