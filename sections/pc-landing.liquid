<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap">
<style>

/* ═══════════ RESET ═══════════ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
img,svg{display:block;max-width:100%}
button{font:inherit;color:inherit;cursor:pointer;border:0;background:none}
a{color:inherit;text-decoration:none}
ul{list-style:none}

/* ═══════════ TOKENS — dark masculine, persimmon-bronze ═══════════ */
:root{
  --bg-0:#161210;        /* page base — deep espresso */
  --bg-1:#1e1815;        /* raised panels */
  --bg-2:#100c0a;        /* deepest bands */
  --bg-bronze:#2a1c12;   /* bronze-tinted band */
  --ink:#f4ece3;         /* primary text — warm white */
  --ink-soft:#c9bcae;    /* secondary */
  --ink-faint:#9a8b7c;   /* tertiary */
  --bronze:#c15a12;      /* accent — persimmon-bronze (ref #B0510E family) */
  --bronze-lt:#e07a2a;   /* bright accent */
  --bronze-deep:#a24a0d; /* CTA base */
  --bronze-press:#8a3f0b;
  --sage:#8fae7d;        /* green-tea cue */
  --charco:#7f95a3;      /* charcoal / front 3 cue */
  --line:rgba(244,236,227,.12);
  --line-soft:rgba(244,236,227,.07);
  --ok:#8fae7d;

  --font-display:'Sora',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  --font-body:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;

  --t-xs:clamp(.72rem, .69rem + .14vw, .8rem);
  --t-sm:clamp(.84rem, .81rem + .16vw, .92rem);
  --t-base:clamp(1rem, .965rem + .2vw, 1.1rem);
  --t-lg:clamp(1.12rem, 1.05rem + .32vw, 1.28rem);
  --t-xl:clamp(1.3rem, 1.15rem + .6vw, 1.6rem);
  --t-2xl:clamp(1.5rem, 1.25rem + 1.1vw, 2.05rem);
  --t-3xl:clamp(1.9rem, 1.45rem + 2vw, 3rem);
  --t-hero:clamp(2.25rem, 1.55rem + 3.4vw, 4.1rem);

  --maxw:1160px; --maxw-prose:60ch;
  --r-sm:.5rem; --r-md:.9rem; --r-lg:1.35rem; --r-xl:1.9rem; --r-full:9999px;
  --sh-md:0 10px 30px rgba(0,0,0,.45);
  --sh-lg:0 26px 60px rgba(0,0,0,.55);
  --sh-bronze:0 14px 34px rgba(193,90,18,.36);
  --ease:cubic-bezier(.16,1,.3,1); --dur:.28s;
  interpolate-size:allow-keywords;
}

/* ═══════════ BASE ═══════════ */
html,body{overflow-x:clip}
body{
  font-family:var(--font-body);
  font-size:var(--t-base);
  line-height:1.65;
  color:var(--ink);
  background:var(--bg-0);
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
  padding-bottom:5rem; /* sticky mobile CTA room */
}
h1,h2,h3,h4{font-family:var(--font-display);font-weight:700;line-height:1.08;letter-spacing:-.02em;text-wrap:balance}
p{text-wrap:pretty}
strong,b{font-weight:700;color:#fff}
em{font-style:italic;color:var(--ink)}
.wrap{width:min(100% - 2.2rem,var(--maxw));margin-inline:auto}
.narrow{max-width:56rem;margin-inline:auto}
section{padding-block:clamp(3.2rem,7vw,6rem)}
.eyebrow{font:700 var(--t-xs)/1 var(--font-body);letter-spacing:.18em;text-transform:uppercase;color:var(--bronze-lt)}
:focus-visible{outline:2.5px solid var(--bronze-lt);outline-offset:3px;border-radius:var(--r-sm)}
.skip{position:absolute;left:1rem;top:-3rem;background:var(--bronze-deep);color:#fff;padding:.55rem 1rem;border-radius:var(--r-sm);z-index:1200;transition:top var(--dur) var(--ease)}
.skip:focus{top:.6rem}
.stars{color:var(--bronze-lt);letter-spacing:.12em;font-size:1rem}

/* ═══════════ MEDIA (owned images) ═══════════ */
.media{position:relative;width:100%;aspect-ratio:var(--ar,1/1);border-radius:var(--r-lg);overflow:hidden;background:var(--bg-1);box-shadow:var(--sh-lg);isolation:isolate}
.media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.lp-fig{width:min(100%,26rem);margin:clamp(1.8rem,4vw,2.4rem) auto 0}
.lp-fig .media{--ar:4/5}
.lp-fig--diagram{width:min(100%,30rem)}
.lp-fig--diagram .media{--ar:1/1}
/* ═══════════ BUTTONS ═══════════ */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;min-height:58px;padding:1rem 2rem;border-radius:var(--r-full);
  font:700 var(--t-lg)/1 var(--font-display);letter-spacing:.02em;text-transform:uppercase;text-align:center;
  transition:transform var(--dur) var(--ease),box-shadow var(--dur) var(--ease),background var(--dur) var(--ease)}
.btn--primary{background:linear-gradient(180deg,var(--bronze-lt),var(--bronze-deep));color:#fff;box-shadow:var(--sh-bronze)}
.btn--primary:hover{transform:translateY(-2px);box-shadow:0 20px 44px rgba(193,90,18,.5)}
.btn--primary:active{transform:translateY(0) scale(.99)}
.btn--block{display:flex;width:100%}
.btn__ar{transition:transform var(--dur) var(--ease)}
.btn--primary:hover .btn__ar{transform:translateX(4px)}
.cta-micro{display:flex;align-items:center;gap:.5rem;justify-content:center;font-size:var(--t-sm);color:var(--ink-soft);margin-top:.9rem;text-wrap:pretty}
.cta-micro svg{flex:none;color:var(--ok)}

/* ═══════════ STICKY PROMO BAR (honest launch note — no countdown) ═══════════ */
.promobar{position:sticky;top:0;z-index:1000;background:var(--bg-2);border-bottom:1px solid var(--line);
  display:flex;align-items:center;justify-content:center;gap:.7rem 1.4rem;flex-wrap:wrap;
  padding:.6rem 1rem;text-align:center;font-size:var(--t-xs);letter-spacing:.04em}
.promobar strong{color:var(--bronze-lt);text-transform:uppercase;letter-spacing:.1em}
.promobar .dot{color:var(--ink-faint)}
.promobar__note{color:var(--ink-soft)}

/* ═══════════ HERO ═══════════ */
.hero{position:relative;overflow:hidden;background:
  radial-gradient(120% 90% at 82% 8%,rgba(193,90,18,.28),transparent 46%),
  radial-gradient(90% 80% at 0% 100%,rgba(42,28,18,.9),transparent 60%),
  linear-gradient(160deg,#1c1512,#0f0b09 70%)}
.hero::after{content:"";position:absolute;inset:0;background:linear-gradient(115deg,transparent 40%,rgba(193,90,18,.10) 55%,transparent 68%);pointer-events:none}
.hero__grid{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(1.5rem,4vw,3.5rem);align-items:center;padding-block:clamp(2.4rem,5vw,4.2rem)}
.hero__eyebrow{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;margin-bottom:1.15rem}
.hero h1{font-size:var(--t-hero);color:#fff;margin-bottom:1.15rem}
.hero h1 .hl{color:var(--bronze-lt)}
.hero__lead{font-size:var(--t-lg);color:var(--ink-soft);max-width:40ch;margin-bottom:1.6rem}
.hero__cta{max-width:26rem}
.hero__figure{position:relative}
.hero__figure .media{--ar:4/5;box-shadow:0 40px 80px rgba(0,0,0,.6)}
.hero__badge{position:absolute;right:-.4rem;bottom:1.2rem;z-index:4;width:clamp(84px,10vw,116px);height:clamp(84px,10vw,116px);border-radius:var(--r-full);
  background:radial-gradient(circle at 50% 40%,var(--bronze-lt),var(--bronze-deep));color:#fff;display:grid;place-content:center;text-align:center;
  font:800 .62rem/1.15 var(--font-display);letter-spacing:.04em;text-transform:uppercase;box-shadow:var(--sh-bronze);border:2px solid rgba(255,255,255,.14);padding:.4rem}
.hero__badge b{font-size:1.35rem;display:block}
/* press strip */
.pressstrip{margin-top:clamp(1.6rem,4vw,2.4rem);border-top:1px solid var(--line);padding-top:1.5rem;
  display:grid;grid-template-columns:repeat(4,1fr);gap:1rem 1.4rem}
.pressstrip li{display:flex;gap:.6rem;font-size:var(--t-sm);color:var(--ink-soft);line-height:1.4}
.pressstrip svg{flex:none;color:var(--bronze-lt);margin-top:.15rem}

/* ═══════════ BENEFIT STRIP (3 frentes) ═══════════ */
.benefitstrip{background:var(--bg-bronze);border-block:1px solid var(--line)}
.benefitstrip .row{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.9rem clamp(1.5rem,5vw,3.5rem);padding-block:1.35rem}
.benefitstrip .item{display:flex;align-items:center;gap:.6rem;font:700 var(--t-sm)/1 var(--font-display);letter-spacing:.12em;text-transform:uppercase;color:#fff}
.benefitstrip .n{color:var(--bronze-lt);font-size:1.1rem}
.benefitstrip .sep{color:var(--ink-faint);display:none}

/* ═══════════ TRANSITION CLAIM ═══════════ */
.claimband{background:var(--bg-2);text-align:center}
.claimband h2{font-size:var(--t-3xl);color:#fff;max-width:20ch;margin-inline:auto}
.claimband .accent{color:var(--bronze-lt)}

/* ═══════════ MECHANISM (3 frentes blocks) ═══════════ */
.mech{background:linear-gradient(180deg,var(--bg-0),var(--bg-1))}
.mech__head{text-align:center;max-width:44rem;margin:0 auto clamp(2.4rem,5vw,3.6rem)}
.mech__head h2{font-size:var(--t-2xl);color:#fff;letter-spacing:.02em;text-transform:uppercase;margin-bottom:1rem}
.mech__head p{color:var(--ink-soft);font-size:var(--t-lg)}
.mech__block{margin-bottom:clamp(.9rem,2vw,1.3rem)}
.mech__block:last-of-type{margin-bottom:0}
.mech__body{display:grid;grid-template-columns:448px 1fr;gap:clamp(1.5rem,4vw,3.4rem);align-items:center;padding:.4rem 1.25rem 1.5rem}
.mech__block--flip .mech__body .mech__media{order:2}
.mech__media .media{--ar:1/1;max-width:448px;margin-inline:auto}
.mech__num{display:inline-flex;align-items:center;justify-content:center;width:2.6rem;height:2.6rem;border-radius:var(--r-full);flex:none;
  background:rgba(193,90,18,.16);border:1px solid rgba(224,122,42,.4);color:var(--bronze-lt);font:800 1.15rem/1 var(--font-display);margin-bottom:1rem}
.mech__block h3{font-size:var(--t-xl);color:#fff;margin-bottom:1rem}
.mech__block>summary{padding:1.15rem 1.25rem}
.mech__block>summary .mech__num{margin-bottom:0;width:2.2rem;height:2.2rem;font-size:1rem}
.mech__block>summary h3{font-size:var(--t-lg);margin-bottom:0;line-height:1.25;text-align:left}
.mech__block p{color:var(--ink-soft);max-width:46ch}
.mech__cite{display:block;margin-top:1rem;font-size:var(--t-xs);color:var(--ink-faint);font-style:italic;line-height:1.5}
.badge-proof{display:inline-flex;align-items:center;gap:.45rem;margin-bottom:.9rem;font:700 var(--t-xs)/1 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--ok);background:rgba(143,174,125,.12);border:1px solid rgba(143,174,125,.32);padding:.4rem .7rem;border-radius:var(--r-full)}
.mech__equalizer{max-width:44rem;margin:clamp(2rem,4vw,3rem) auto 0;text-align:center;color:var(--ink-soft);font-size:var(--t-base);border-top:1px solid var(--line);padding-top:1.6rem}

/* ═══════════ CTA BAND ═══════════ */
.ctaband{background:var(--bg-bronze);border-block:1px solid var(--line);text-align:center}
.ctaband h2{font-size:var(--t-2xl);color:#fff;margin-bottom:1.4rem}
.ctaband .btn{margin-inline:auto}
.ctaband--tight{padding-block:clamp(2.4rem,5vw,3.4rem)}

/* return line */
.returnline{background:var(--bg-2);text-align:center;padding-block:clamp(2rem,4vw,2.8rem)}
.returnline p{font:700 var(--t-xl)/1.2 var(--font-display);text-transform:uppercase;letter-spacing:.04em;color:#fff}
.returnline .accent{color:var(--bronze-lt)}

/* ═══════════ TIMELINE (compliant reframe) ═══════════ */
.timeline{background:linear-gradient(180deg,var(--bg-1),var(--bg-0))}
.timeline__head{text-align:center;max-width:46rem;margin:0 auto clamp(2.4rem,5vw,3.4rem)}
.timeline__head h2{font-size:var(--t-3xl);color:#fff;margin-bottom:1rem}
.timeline__head p{color:var(--ink-soft);font-size:var(--t-lg)}
.timeline__stages{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(1rem,2.5vw,1.8rem)}
.stage{background:var(--bg-1);border:1px solid var(--line);border-radius:var(--r-lg);padding:0;position:relative}
.stage>summary{padding:1.15rem 1.35rem}
.stage__body{padding:.1rem 1.35rem 1.25rem}
.stage__label{font:800 var(--t-sm)/1.3 var(--font-display);letter-spacing:.1em;text-transform:uppercase;color:var(--bronze-lt);margin-bottom:0;display:flex;align-items:center;gap:.6rem;text-align:left}
.stage__label::before{content:"";width:.7rem;height:.7rem;border-radius:var(--r-full);background:var(--bronze-lt);box-shadow:0 0 0 4px rgba(193,90,18,.2)}
.stage__item{padding-block:.95rem;border-top:1px solid var(--line-soft)}
.stage__item:first-of-type{border-top:0;padding-top:0}
.stage__item h4{font-size:var(--t-base);color:#fff;margin-bottom:.3rem;font-family:var(--font-display);font-weight:600}
.stage__item p{font-size:var(--t-sm);color:var(--ink-faint);line-height:1.5}
.timeline__foot{text-align:center;color:var(--ink-faint);font-size:var(--t-sm);margin-top:1.8rem;font-style:italic}

/* ═══════════ PROOF / REVIEWS — real testimonials (primer lote) ═══════════ */
.proof{background:var(--bg-2);text-align:center}
.proof__quote{max-width:42rem;margin:0 auto clamp(2.4rem,5vw,3.4rem)}
.proof__quote h2{font-size:var(--t-2xl);color:#fff;margin-bottom:1rem}
.proof__quote p{color:var(--ink-soft)}
.proof__foot{color:var(--ink-faint);font-size:var(--t-sm);margin-top:1.8rem;font-style:italic}
.reviews{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem;text-align:left}
.tcard{background:var(--bg-1);border:1px solid var(--line);border-radius:var(--r-md);padding:1.3rem 1.35rem;display:flex;flex-direction:column;gap:.8rem;min-width:0;text-align:left}
.tcard blockquote{font-size:var(--t-sm);color:var(--ink);line-height:1.6;overflow-wrap:break-word;text-wrap:pretty}
.tcard blockquote::before{content:"“";color:var(--bronze-lt)}
.tcard blockquote::after{content:"”";color:var(--bronze-lt)}
.tcard footer{margin-top:auto;padding-top:.8rem;border-top:1px solid var(--line-soft);font:600 var(--t-xs)/1.35 var(--font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--ink-faint);display:flex;align-items:center;gap:.7rem}
/* avatars (pseudonymized) */
.tavatar{width:46px;height:46px;border-radius:var(--r-full);object-fit:cover;flex:none;border:1.5px solid rgba(224,122,42,.35);background:var(--bg-2)}
.tavatar--lg{width:56px;height:56px}
.tmeta{display:flex;flex-direction:column;gap:.18rem;min-width:0}
.tname{color:var(--ink);font-weight:700;letter-spacing:.05em}
.tdisclose{font-size:var(--t-xs);color:var(--ink-faint);text-align:center;font-style:italic;margin-top:1.1rem;line-height:1.55}
/* testimonial sets (trios woven between sections) */
.tset{background:var(--bg-0);padding-block:clamp(2.4rem,5vw,3.6rem)}
.tset--deep{background:var(--bg-1)}
.tset__eyebrow{text-align:center;margin-bottom:1.5rem;display:block}
.tgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.1rem}
/* quote strip under hero */
.qstrip{background:var(--bg-2);border-bottom:1px solid var(--line);padding-block:clamp(1.8rem,4vw,2.6rem)}
/* featured big testimonial */
.tfeat{background:linear-gradient(180deg,var(--bg-bronze),var(--bg-2));border-block:1px solid var(--line);text-align:center}
.tfeat__mark{font:800 4rem/.6 var(--font-display);color:var(--bronze-lt);display:block;margin-bottom:1.3rem}
.tfeat blockquote{max-width:46rem;margin-inline:auto;font:600 var(--t-xl)/1.55 var(--font-display);color:#fff;letter-spacing:-.01em;text-wrap:pretty}
.tfeat blockquote::before{content:"“"}
.tfeat blockquote::after{content:"”"}
.tfeat footer{margin-top:1.5rem;font:700 var(--t-xs)/1.3 var(--font-body);letter-spacing:.14em;text-transform:uppercase;color:var(--bronze-lt);display:flex;flex-direction:column;align-items:center;gap:.7rem}

/* ═══════════ TESTIMONIAL CAROUSELS (scroll-snap, no library) ═══════════ */
.tnav{display:flex;align-items:center;justify-content:center;gap:.9rem;margin-top:1.1rem}
.tnav__btn{display:inline-flex;align-items:center;justify-content:center;width:2.5rem;height:2.5rem;border-radius:var(--r-full);border:1px solid var(--line);background:var(--bg-1);color:var(--bronze-lt);transition:border-color var(--dur) var(--ease),color var(--dur) var(--ease)}
.tnav__btn:hover{border-color:var(--bronze-lt);color:#fff}
.tnav__dots{display:flex;gap:.5rem}
.tnav__dot{width:.55rem;height:.55rem;border-radius:var(--r-full);background:rgba(244,236,227,.22);padding:0;transition:background var(--dur) var(--ease),transform var(--dur) var(--ease)}
.tnav__dot[aria-current="true"]{background:var(--bronze-lt);transform:scale(1.25)}
@media (max-width:1023px){
  .tcarousel{display:flex;gap:.9rem;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-inline:1.1rem;padding:.2rem 1.1rem .5rem;margin-inline:-1.1rem;max-width:none;-webkit-overflow-scrolling:touch;scrollbar-width:none;overscroll-behavior-x:contain}
  .tcarousel::-webkit-scrollbar{display:none}
  .tcarousel>.tcard{flex:0 0 clamp(16rem,85vw,23rem);scroll-snap-align:center}
}
@media (min-width:1024px){.tnav{display:none}}

/* ═══════════ ACCORDIONS (details/summary, amber chevron) ═══════════ */
.acc{background:var(--bg-1);border:1px solid var(--line);border-radius:var(--r-md)}
.acc>summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:.8rem;padding:1.05rem 1.2rem}
.acc>summary::-webkit-details-marker{display:none}
.acc__chev{margin-left:auto;flex:none;color:var(--bronze-lt);transition:transform var(--dur) var(--ease)}
.acc[open]>summary .acc__chev{transform:rotate(180deg)}
.acc::details-content{block-size:0;overflow:clip;transition:block-size .32s var(--ease),content-visibility .32s allow-discrete}
.acc[open]::details-content{block-size:auto}
@media (min-width:1024px){
  .acc--auto.is-static>summary{pointer-events:none}
  .acc--auto.is-static .acc__chev{display:none}
}

/* ═══════════ VIDEO CLIPS ═══════════ */
.vid-fig{width:min(100%,34rem);margin:clamp(1.6rem,4vw,2.2rem) auto 0}
.vid-fig video{width:100%;height:auto;aspect-ratio:16/9;display:block;object-fit:cover;border-radius:var(--r-lg);background:var(--bg-1);box-shadow:var(--sh-lg)}
.vid-fig figcaption{font-size:var(--t-xs);color:var(--ink-faint);text-align:center;margin-top:.7rem;font-style:italic;line-height:1.5}
/* trust quotes at the offer */
.offer__trust{margin-top:1.4rem;display:grid;grid-template-columns:1fr 1fr;gap:.9rem}
/* hero proof link */
.eyebrow--proof{color:var(--ink-soft);text-decoration:underline;text-underline-offset:.28em;text-decoration-color:var(--bronze)}
.eyebrow--proof:hover{color:var(--bronze-lt)}

/* ═══════════ EDUCATION ═══════════ */
.edu{background:linear-gradient(180deg,var(--bg-0),var(--bg-1))}
.edu__inner{max-width:46rem;margin-inline:auto}
.edu h2{font-size:var(--t-3xl);color:#fff;margin-bottom:1.6rem;text-align:center}
.edu h2 .accent{color:var(--bronze-lt)}
.edu p{color:var(--ink-soft);margin-bottom:1.15rem;font-size:var(--t-lg)}
.edu .note{font-size:var(--t-base);color:var(--ink-faint);font-style:italic;border-left:2px solid var(--bronze);padding-left:1.1rem}
.edu ul.ledger{margin:1.4rem 0;display:grid;gap:.9rem}
.edu ul.ledger li{display:flex;gap:.8rem;color:var(--ink-soft);font-size:var(--t-base)}
.edu ul.ledger svg{flex:none;color:var(--bronze-lt);margin-top:.25rem}
.edu .kicker{font-size:var(--t-xl);color:#fff;font-family:var(--font-display);font-weight:700;text-align:center;margin-top:2rem;letter-spacing:-.01em}

/* ═══════════ OFFER ═══════════ */
.offer{background:var(--bg-2)}
.offer__head{text-align:center;max-width:44rem;margin:0 auto clamp(2rem,4vw,3rem)}
.offer__head h2{font-size:var(--t-3xl);color:#fff;margin-bottom:1rem}
.offer__head .frame{color:var(--ink-soft);font-size:var(--t-lg)}
.offer__head .frame b{color:var(--bronze-lt)}
.offer__grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(1.5rem,4vw,3rem);align-items:start}
.offer__figure .media{--ar:4/3}
.offer__figcap{font-size:var(--t-xs);color:var(--ink-faint);text-align:center;margin-top:.8rem;font-style:italic;line-height:1.5}
/* offer product gallery */
.offer__figure{min-width:0}
.offer__figure .media.gallery__main{--ar:1/1}
.gallery__main img{transition:opacity .15s ease}
.gallery__main img.is-fading{opacity:0}
.gallery__thumbs{display:flex;gap:.6rem;margin-top:.9rem;padding:.2rem .2rem .5rem;max-width:100%;overflow-x:auto;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch;scrollbar-width:thin;scrollbar-color:var(--bronze) transparent}
.gallery__thumb{flex:0 0 auto;width:78px;height:78px;border-radius:var(--r-md);overflow:hidden;border:2px solid var(--line);background:var(--bg-1);opacity:.65;transition:opacity var(--dur) var(--ease),border-color var(--dur) var(--ease)}
.gallery__thumb img{width:100%;height:100%;aspect-ratio:1/1;object-fit:cover}
.gallery__thumb:hover{opacity:1}
.gallery__thumb[aria-current="true"]{border-color:var(--bronze-lt);opacity:1}
@media (max-width:640px){.gallery__thumb{width:72px;height:72px}}
.ladder{display:grid;gap:1rem}
.tier{background:var(--bg-1);border:1px solid var(--line);border-radius:var(--r-lg);padding:1.3rem 1.4rem;display:grid;grid-template-columns:1fr auto;gap:.4rem 1rem;align-items:center}
.tier--hero{border-color:var(--bronze);box-shadow:0 0 0 1px var(--bronze),var(--sh-md);position:relative}
.tier--hero::before{content:"El favorito para empezar";position:absolute;top:-.75rem;left:1.3rem;background:var(--bronze-deep);color:#fff;font:700 .62rem/1 var(--font-body);letter-spacing:.08em;text-transform:uppercase;padding:.35rem .6rem;border-radius:var(--r-full)}
.tier__name{font:700 var(--t-lg)/1.1 var(--font-display);color:#fff}
.tier__meta{font-size:var(--t-sm);color:var(--ink-faint);grid-column:1}
.tier__price{font:800 var(--t-xl)/1 var(--font-display);color:var(--bronze-lt);text-align:right}
.tier__sub{font-size:var(--t-xs);color:var(--ink-faint);text-align:right;grid-column:2}
.offer__addons{margin-top:1.2rem;display:grid;gap:.85rem}
.addon{background:var(--bg-1);border:1px dashed var(--line);border-radius:var(--r-md);padding:1rem 1.15rem;font-size:var(--t-sm);color:var(--ink-soft)}
.addon b{color:#fff}
.offer__urgency{margin-top:1.3rem;background:rgba(193,90,18,.1);border:1px solid rgba(224,122,42,.3);border-radius:var(--r-md);padding:1rem 1.2rem;font-size:var(--t-sm);color:var(--ink-soft)}
.offer__urgency b{color:var(--bronze-lt)}
.ladder__cta{margin-top:1.3rem}

/* ═══════════ GUARANTEE ═══════════ */
.guarantee{background:linear-gradient(180deg,var(--bg-bronze),var(--bg-2));text-align:center}
.guarantee__inner{max-width:40rem;margin-inline:auto}
.guarantee .seal{width:clamp(66px,9vw,86px);height:clamp(66px,9vw,86px);border-radius:var(--r-full);margin:0 auto 1.4rem;
  background:radial-gradient(circle at 50% 40%,var(--bronze-lt),var(--bronze-deep));display:grid;place-content:center;box-shadow:var(--sh-bronze);border:2px solid rgba(255,255,255,.16)}
.guarantee h2{font-size:var(--t-3xl);color:#fff;text-transform:uppercase;letter-spacing:.02em;margin-bottom:1.2rem}
.guarantee__hero{font-size:var(--t-lg);color:#fff;font-weight:600;margin-bottom:1.2rem}
.guarantee__hero .accent{color:var(--bronze-lt)}
.guarantee p.sub{color:var(--ink-soft);margin-bottom:1.6rem}
.guarantee details{text-align:left;background:var(--bg-1);border:1px solid var(--line);border-radius:var(--r-md);margin-bottom:1.6rem}
.guarantee summary{padding:1rem 1.2rem;font-weight:600;color:#fff;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:1rem}
.guarantee summary::-webkit-details-marker{display:none}
.guarantee summary::after{content:"+";color:var(--bronze-lt);font-size:1.4rem;line-height:1}
.guarantee details[open] summary::after{content:"–"}
.guarantee details ul{padding:0 1.2rem 1.2rem;display:grid;gap:.7rem}
.guarantee details li{display:flex;gap:.7rem;color:var(--ink-soft);font-size:var(--t-sm)}
.guarantee details svg{flex:none;color:var(--ok);margin-top:.2rem}

/* ═══════════ FAQ ═══════════ */
.faq{background:var(--bg-0)}
.faq h2{text-align:center;font-size:var(--t-2xl);color:#fff;margin-bottom:clamp(1.8rem,4vw,2.6rem)}
.faq__list{max-width:44rem;margin-inline:auto;display:grid;gap:.8rem}
.faq details{background:var(--bg-1);border:1px solid var(--line);border-radius:var(--r-md)}
.faq summary{padding:1.1rem 1.3rem;font:600 var(--t-base)/1.4 var(--font-display);color:#fff;cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:1rem;align-items:center}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";color:var(--bronze-lt);font-size:1.4rem;flex:none;line-height:1}
.faq details[open] summary::after{content:"–"}
.faq details p{padding:0 1.3rem 1.2rem;color:var(--ink-soft);font-size:var(--t-sm)}

/* ═══════════ EMAIL FOOTER ═══════════ */
.footer{background:var(--bg-2);border-top:1px solid var(--line);text-align:center}
.footer h2{font-size:var(--t-2xl);color:#fff;margin-bottom:.7rem}
.footer p.sub{color:var(--ink-soft);margin-bottom:1.6rem;font-size:var(--t-sm)}
.signup{display:flex;gap:.7rem;max-width:30rem;margin:0 auto 2rem;flex-wrap:wrap}
.signup input{flex:1 1 12rem;min-height:52px;padding:.8rem 1.1rem;border-radius:var(--r-full);background:var(--bg-1);border:1px solid var(--line);color:var(--ink);font:inherit}
.signup input::placeholder{color:var(--ink-faint)}
.signup button{min-height:52px;padding:.8rem 1.6rem;border-radius:var(--r-full);background:var(--bronze-deep);color:#fff;font:700 var(--t-sm)/1 var(--font-display);letter-spacing:.06em;text-transform:uppercase}
.footer__legal{border-top:1px solid var(--line-soft);padding-top:1.6rem;color:var(--ink-faint);font-size:var(--t-xs);max-width:52rem;margin-inline:auto;line-height:1.7}
.footer__brand{font:800 1.3rem/1 var(--font-display);color:#fff;letter-spacing:.02em;margin-bottom:1rem;display:inline-block}

/* ═══════════ STICKY MOBILE CTA ═══════════ */
.mcta{position:fixed;left:0;right:0;bottom:0;z-index:1000;display:none;gap:.8rem;align-items:center;justify-content:space-between;
  padding:.7rem 1rem;background:rgba(16,12,10,.92);backdrop-filter:blur(10px);border-top:1px solid var(--line)}
.mcta__price{font:800 var(--t-base)/1 var(--font-display);color:#fff}
.mcta__price span{display:block;font:500 var(--t-xs)/1.2 var(--font-body);color:var(--ink-faint);text-transform:none;letter-spacing:0;margin-top:.2rem}
.mcta .btn{min-height:50px;padding:.7rem 1.3rem;font-size:var(--t-base);flex:none}

/* ═══════════ RESPONSIVE ═══════════ */
@media (max-width:1000px){
  .mech__body{grid-template-columns:1fr;gap:1.4rem}
  .mech__block--flip .mech__body .mech__media{order:0}
  .mech__media .media{max-width:520px}
  .offer__grid{grid-template-columns:1fr}
  .offer__figure{width:min(100%,32rem);margin-inline:auto}
}
@media (max-width:860px){
  .hero__grid{grid-template-columns:1fr;text-align:center}
  .hero__eyebrow{justify-content:center}
  .hero__lead{margin-inline:auto}
  .hero__cta{margin-inline:auto}
  .hero__figure{order:-1;width:min(100%,24rem);margin-inline:auto}
  .pressstrip{grid-template-columns:repeat(2,1fr);text-align:left}
  .timeline__stages{grid-template-columns:1fr;max-width:32rem;margin-inline:auto}
}
@media (max-width:640px){
  .mcta{display:flex}
  body{padding-bottom:5.4rem}
  .benefitstrip .item{font-size:.72rem;letter-spacing:.08em}
  .offer__trust{grid-template-columns:1fr}
  .tier{grid-template-columns:1fr;text-align:left}
  .tier__sub{grid-column:1}
  .hero__figure{width:min(100%,13rem)}
  .hero__figure .media{--ar:1/1}
  .hero__grid{padding-block-start:1.5rem}
  .tier__price,.tier__sub{text-align:left}
  .pressstrip{grid-template-columns:1fr}
  /* mobile height pass — tighter vertical rhythm, same copy */
  section{padding-block:2.3rem}
  .tset{padding-block:1.7rem}
  .qstrip{padding-block:1.4rem}
  .ctaband--tight{padding-block:1.8rem}
  .returnline{padding-block:1.6rem}
  .hero__grid{gap:1.2rem}
  .pressstrip{margin-top:1.2rem;padding-top:1.1rem;gap:.65rem}
  .mech__head{margin-bottom:1.6rem}
  .timeline__head{margin-bottom:1.6rem}
  .proof__quote{margin-bottom:1.5rem}
  .offer__head{margin-bottom:1.4rem}
  .edu p{margin-bottom:.9rem}
  .edu .kicker{margin-top:1.3rem}
  .lp-fig,.vid-fig{margin-top:1.3rem}
  .guarantee p.sub{margin-bottom:1.2rem}
  .mech__equalizer{margin-top:1.5rem;padding-top:1.2rem}
  .timeline__foot{margin-top:1.2rem}
}
@media (prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}


